# --- LiveKit (both services) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent worker (agent/) ---
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
CEREBRAS_API_KEY=
AWS_REGION=ap-south-1
CW_LOG_GROUP=/vriddhi/agent
CONTEXT_S3_BASE_URL=https://<bucket>.s3.ap-south-1.amazonaws.com
TRANSCRIPT_URL=            # endpoint that receives the end-of-call transcript
BEDROCK_REGION=us-east-1   # only if using Bedrock knowledge bases

# --- Dispatcher (dispatcher/) ---
SIP_OUTBOUND_TRUNK_ID=
CONTEXT_TABLE=ContextIvr
INBOUND_CONTEXT_ID=
INBOUND_CONTEXT_BY_DID={}
LIVEKIT_INBOUND_SIP_URI_TEMPLATE=

# --- WhatsApp (dispatcher + webhook receiver) ---
WHATSAPP_INBOUND_CONTEXT_ID=          # contextId used for inbound WhatsApp calls
WHATSAPP_INBOUND_CONTEXT_BY_NUMBER={} # optional {"<phone_number_id>": "<contextId>"}
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=26.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=       # Meta app secret, used to verify webhook signatures
